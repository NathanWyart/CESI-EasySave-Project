<UserControl x:Class="EasySave.View.SettingsPage"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:vm="clr-namespace:EasySave.ViewModels"
              mc:Ignorable="d"
              Height="Auto" Width="Auto">
	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<StackPanel Grid.Row="0" Margin="0,0,0,30">
			<TextBlock Text="Paramètres" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
		</StackPanel>

		<StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,0,0,30">
			<StackPanel Orientation="Horizontal" Margin="0,5">
				<TextBlock Text="Langue : " VerticalAlignment="Center" Width="180"/>
				<ComboBox Width="150"
                          ItemsSource="{Binding AvailableLanguages}"
                          SelectedItem="{Binding SelectedLanguage, UpdateSourceTrigger=PropertyChanged}" />
			</StackPanel>
			<StackPanel Orientation="Horizontal" Margin="0,5">
				<TextBlock Text="Format des logs : " VerticalAlignment="Center" Width="180"/>
				<ComboBox Width="150"
                          ItemsSource="{Binding AvailableLogFormats}"
                          SelectedItem="{Binding SelectedLogFormat, UpdateSourceTrigger=PropertyChanged}" />
			</StackPanel>
			<StackPanel Orientation="Horizontal" Margin="0,5">
				<TextBlock Text="Taille max fichier (Ko) : " VerticalAlignment="Center" Width="180"/>
				<TextBox Width="100" Text="{Binding MaxParallelFileSizeKo, UpdateSourceTrigger=PropertyChanged}" />
			</StackPanel>
		</StackPanel>

		<Grid Grid.Row="2">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<StackPanel Grid.Column="0">
				<TextBlock Text="Extensions à chiffrer" FontWeight="Bold" Margin="0,0,0,5" FontSize="12"/>
				<ItemsControl ItemsSource="{Binding EncryptedExtensions}">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<StackPanel Orientation="Horizontal">
								<TextBlock Text="{Binding}" Width="100" FontSize="12"/>
								<Button Content="🗑️" ToolTip="Supprimer"
                                        Command="{Binding DataContext.RemoveExtensionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Margin="5,0"
                                        Background="Transparent" BorderThickness="0" FontSize="14" Cursor="Hand"/>
							</StackPanel>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
				<StackPanel Orientation="Horizontal" Margin="0,10,0,0">
					<TextBox Width="100" Text="{Binding NewExtension}" FontSize="12"/>
					<Button Content="🆕" ToolTip="Ajouter"
                            Margin="5,0"
                            Command="{Binding AddExtensionCommand}"
                            Background="Transparent" BorderThickness="0" FontSize="14" Cursor="Hand"/>
				</StackPanel>
			</StackPanel>

			<StackPanel Grid.Column="1">
				<TextBlock Text="Logiciels métier" FontWeight="Bold" Margin="0,0,0,5" FontSize="12"/>
				<ItemsControl ItemsSource="{Binding BusinessSoftwares}">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<StackPanel Orientation="Horizontal">
								<TextBlock Text="{Binding}" Width="100" FontSize="12"/>
								<Button Content="🗑️" ToolTip="Supprimer"
                                        Command="{Binding DataContext.RemoveSoftwareCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Margin="5,0"
                                        Background="Transparent" BorderThickness="0" FontSize="14" Cursor="Hand"/>
							</StackPanel>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
				<StackPanel Orientation="Horizontal" Margin="0,10,0,0">
					<TextBox Width="100" Text="{Binding NewSoftware}" FontSize="12"/>
					<Button Content="🆕" ToolTip="Ajouter"
                            Margin="5,0"
                            Command="{Binding AddSoftwareCommand}"
                            Background="Transparent" BorderThickness="0" FontSize="14" Cursor="Hand"/>
				</StackPanel>
			</StackPanel>

			<StackPanel Grid.Column="2">
				<TextBlock Text="Extensions prioritaires" FontWeight="Bold" Margin="0,0,0,5" FontSize="12"/>
				<ItemsControl ItemsSource="{Binding PriorityExtensions}">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<StackPanel Orientation="Horizontal">
								<TextBlock Text="{Binding}" Width="100" FontSize="12"/>
								<Button Content="🗑️" ToolTip="Supprimer"
                                        Command="{Binding DataContext.RemovePriorityExtensionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Margin="5,0"
                                        Background="Transparent" BorderThickness="0" FontSize="14" Cursor="Hand"/>
							</StackPanel>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
				<StackPanel Orientation="Horizontal" Margin="0,10,0,0">
					<TextBox Width="100" Text="{Binding NewPriorityExtension}" FontSize="12"/>
					<Button Content="🆕" ToolTip="Ajouter"
                            Margin="5,0"
                            Command="{Binding AddPriorityExtensionCommand}"
                            Background="Transparent" BorderThickness="0" FontSize="14" Cursor="Hand"/>
				</StackPanel>
			</StackPanel>
		</Grid>
	</Grid>
</UserControl>