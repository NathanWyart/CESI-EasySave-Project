<UserControl x:Class="EasySave.View.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:EasySave.ViewModels"
    xmlns:model="clr-namespace:NS_Model"
    Height="Auto" Width="Auto">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Travaux de sauvegarde"
                   FontSize="20"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"
                   Grid.Row="0"/>

        <DataGrid ItemsSource="{Binding Works}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  Grid.Row="1"
                  Margin="0,0,0,10"
                  IsReadOnly="True"
                  GridLinesVisibility="None"
                  HeadersVisibility="Column">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Source" Binding="{Binding Src}" Width="*"/>
                <DataGridTextColumn Header="Destination" Binding="{Binding Dst}" Width="*"/>
                <DataGridTextColumn Header="Type" Binding="{Binding BackupType}" Width="*"/>
                <DataGridTextColumn Header="Dernière sauvegarde" Binding="{Binding LastBackupDate}" Width="*"/>

                <DataGridTemplateColumn Header="Actions" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="▶️"
                                        ToolTip="Exécuter"
                                        Command="{Binding DataContext.ExecuteWorkCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Margin="2"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="Black"
                                        Cursor="Hand"/>
                                <Button Content="🗑️"
                                        ToolTip="Supprimer"
                                        Command="{Binding DataContext.DeleteWorkCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Margin="2"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="Black"
                                        Cursor="Hand"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.Row="2" Margin="0,10,0,0">
            <Button Content="Ajouter" Width="100" Margin="5" Command="{Binding AddWorkCommand}"/>
            <Button Content="Exécuter tout" Width="120" Margin="5" Command="{Binding ExecuteAllCommand}"/>
            <Button Content="Supprimer tout" Width="140" Margin="5" Command="{Binding DeleteAllCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>