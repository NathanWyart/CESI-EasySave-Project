<Window x:Class="EasySave.View.AddWorkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NS_ViewModel"
        Title="{Binding [AddBackup], Source={x:Static vm:LanguageService.Instance}}"
        Height="330" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,5">
            <TextBlock Text="{Binding [EnterName], Source={x:Static vm:LanguageService.Instance}}" FontWeight="Bold"/>
            <TextBox x:Name="NameBox"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,5">
            <TextBlock Text="{Binding [EnterSource], Source={x:Static vm:LanguageService.Instance}}" FontWeight="Bold"/>
            <TextBox x:Name="SrcBox"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,5">
            <TextBlock Text="{Binding [EnterDestination], Source={x:Static vm:LanguageService.Instance}}" FontWeight="Bold"/>
            <TextBox x:Name="DstBox"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,5">
            <TextBlock Text="{Binding [EnterType], Source={x:Static vm:LanguageService.Instance}}" FontWeight="Bold"/>
            <ComboBox x:Name="TypeBox" SelectedIndex="0">
                <ComboBoxItem Content="FULL"/>
                <ComboBoxItem Content="DIFFERENTIAL"/>
            </ComboBox>
        </StackPanel>

        <Button Grid.Row="4"
                Content="{Binding [AddBackup], Source={x:Static vm:LanguageService.Instance}}"
                Width="100"
                Margin="0,15,0,0"
                HorizontalAlignment="Center"
                Click="OnValidate"/>
    </Grid>
</Window>