<Window x:Class="RemoteConsoleApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Deported Console - EasySave" Height="450" Width="800">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Background="#2E3B4E" Orientation="Vertical" Grid.Column="0">
            <TextBlock Text="Deported Console"
                       Foreground="White"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="10"
                       HorizontalAlignment="Center"/>
            <Separator Margin="0,10"/>
            <TextBlock Text="MONITORING"
                       Foreground="White"
                       FontSize="14"
                       Margin="10,20,10,5"/>
        </StackPanel>

        <Grid Grid.Column="1" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Suivi des travaux de sauvegarde"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="Black"
                       Margin="10"
                       HorizontalAlignment="Center"/>

            <ListView Grid.Row="1"
                      ItemsSource="{Binding States, Mode=OneWay}"
                      Margin="10"
                      Background="White"
                      Foreground="Black"
                      BorderThickness="0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Nom" 
                                        DisplayMemberBinding="{Binding Name, Mode=OneWay}" 
                                        Width="150"/>
                        <GridViewColumn Header="Progression (%)" 
                                        DisplayMemberBinding="{Binding Progress, Mode=OneWay}" 
                                        Width="120"/>
                        <GridViewColumn Header="Statut" 
                                        DisplayMemberBinding="{Binding StateStatus, Mode=OneWay}" 
                                        Width="100"/>
                        <GridViewColumn Header="Actions" Width="200">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0">
                                        <Button Content="⏸️" ToolTip="Pause"
                                                Click="Pause_Click"
                                                Background="Transparent" BorderThickness="0"
                                                FontSize="16" Cursor="Hand" Margin="5,0"/>
                                        <Button Content="▶️" ToolTip="Play"
                                                Click="Resume_Click"
                                                Background="Transparent" BorderThickness="0"
                                                FontSize="16" Cursor="Hand" Margin="5,0"/>
                                        <Button Content="❌" ToolTip="Cancel"
                                                Click="Cancel_Click"
                                                Background="Transparent" BorderThickness="0"
                                                FontSize="16" Cursor="Hand" Margin="5,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
    </Grid>
</Window>