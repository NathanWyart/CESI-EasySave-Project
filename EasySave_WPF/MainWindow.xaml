<Window x:Class="EasySave_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EasySave_WPF.ViewModels"
        Title="EasySave 2.0" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Barre latérale de navigation -->
        <!-- Barre latérale de navigation -->
        <StackPanel Grid.Column="0" Background="#2F3542" Margin="10">
            <TextBlock Text="EasySave" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0 0 0 20"/>

            <Button Content="Travaux"
            Command="{Binding ShowWorkListCommand}"
            Margin="0 5" Padding="5" Foreground="White" Background="#57606f"/>

            <Button Content="Exécution"
            Command="{Binding ShowExecutionCommand}"
            Margin="0 5" Padding="5" Foreground="White" Background="#57606f"/>

            <Button Content="Logiciels métier"
            Command="{Binding ShowBusinessSoftwareCommand}"
            Margin="0 5" Padding="5" Foreground="White" Background="#57606f"/>

            <Button Content="Paramètres"
            Command="{Binding ShowSettingsCommand}"
            Margin="0 5" Padding="5" Foreground="White" Background="#57606f"/>      
        </StackPanel>


        <!-- Contenu dynamique -->
        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentPage}"
                        Margin="10"/>
    </Grid>
</Window>
