<UserControl x:Class="EasySave_WPF.View.WorkListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:viewmodels="clr-namespace:EasySave_WPF.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:WorkListViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="800">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titre -->
        <TextBlock Text="EasySave 2.0 - Gestion des Travaux de Sauvegarde" 
                   FontSize="20" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,10"/>

        <!-- Liste des travaux (dynamique) -->
        <ListView Grid.Row="1" Margin="0,10" SelectionMode="Single"
                  ItemsSource="{Binding Works}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Nom" Width="150" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="Source" Width="250" DisplayMemberBinding="{Binding Src}" />
                    <GridViewColumn Header="Destination" Width="250" DisplayMemberBinding="{Binding Dst}" />
                    <GridViewColumn Header="Type" Width="100" DisplayMemberBinding="{Binding BackupType}" />
                    <GridViewColumn Header="Actions" Width="200">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="Exécuter" Margin="2"
                        Command="{Binding DataContext.ExecuteWorkCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                        CommandParameter="{Binding}" />
                                    <Button Content="Supprimer" Margin="2"
                        Command="{Binding DataContext.DeleteWorkCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                        CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Boutons globaux -->
        <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Center" Margin="0,10">
            <Button Content="Ajouter" Width="100" Margin="5" Command="{Binding OpenAddPopupCommand}" />
            <Button Content="Tout exécuter" Width="120" Margin="5" Command="{Binding ExecuteAllCommand}" />
            <Button Content="Tout supprimer" Width="120" Margin="5" Command="{Binding DeleteAllCommand}" />
            <Button Content="Paramètres" Width="100" Margin="5" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</UserControl>
